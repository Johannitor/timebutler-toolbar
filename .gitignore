# Generated by XcodeGen (regenerate with `xcodegen generate`)
*.xcodeproj
*.xcworkspace

# Build output
build/
DerivedData/
.build/
.swiftpm/
*.xcarchive
*.app
*.dmg
*.zip

# Xcode user state
xcuserdata/
*.xcuserstate

# Local signing configuration (contains your Apple team ID)
Config/Local.xcconfig

# Secrets and signing material — never commit these
.env
.env.*
*.p8
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.keychain
*.keychain-db

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
