// Signing defaults for both targets.
//
// Out of the box the app is signed ad hoc, so anyone can build and test it
// without an Apple Developer account. To sign with your own team, copy
// Local.xcconfig.example to Local.xcconfig (git-ignored) and fill in your
// team ID.

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
